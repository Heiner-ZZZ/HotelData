// ============================================================================
// HOTELDATA HUB - Departamento 1: Comercial / Experiencia Cliente
// Modelo de Datos (dbdiagram.io DSL)
// ============================================================================
// Pegar en https://dbdiagram.io para generar el diagrama ER
// ============================================================================

// ============================================================================
// TABLAS PROPIAS (18 colecciones)
// ============================================================================

Table dim_hotels {
  prop_id int [pk]
  prop_country_id int
  prop_starrating int
  prop_review_score decimal
  prop_brand_bool bool
  prop_location_score1 decimal
  hotel_label varchar(255)
  loaded_at timestamp
  manual_override bool
  name_source varchar(50)
  original_generated_name varchar(255)
  description text
  display_country_label varchar(255)
  display_name varchar(255)
  hotel_name varchar(255)
  updated_at timestamp
  updated_by varchar(100)
  verified_at timestamp
}

Table dim_destinations {
  srch_destination_id int [pk]
  destination_label varchar(255)
  loaded_at timestamp
  destination_display_name varchar(255)
  destination_name varchar(255)
}

Table dim_visitor_countries {
  visitor_location_country_id int [pk]
  visitor_country_label varchar(255)
  loaded_at timestamp
  country_display_name varchar(255)
  country_name varchar(255)
}

Table room_types {
  id varchar(24) [pk]
  room_type_id varchar(100) [unique, not null]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  name varchar(255)
  description text
  max_adults int
  max_children int
  base_capacity int
  base_rate decimal
  is_active bool [default: true]
  room_number varchar(20)
  floor varchar(10)
  view varchar(100)
  smoking bool
  accessible bool
  is_roh bool [default: false]
  features text
  created_at timestamp
  updated_at timestamp
}

Table room_inventory_calendar {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_type_id varchar(100) [not null, ref: > room_types.room_type_id]
  date date [not null]
  total_rooms int
  available_rooms int
  blocked_rooms int [default: 0]
  version int [default: 1]
  is_deleted bool [default: false]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp

  Indexes {
    (prop_id, room_type_id, date) [unique]
  }
}

Table hotel_rate_calendar {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  rate_plan_id varchar(100) [not null, ref: > rate_plans.rate_plan_id]
  date date [not null]
  rate_amount decimal
  is_closed bool [default: false]

  Indexes {
    (prop_id, rate_plan_id, date) [unique]
  }
}

Table rate_plans {
  id varchar(24) [pk]
  rate_plan_id varchar(100) [unique, not null]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  name varchar(255)
  base_rate decimal
  is_active bool [default: true]
  eligible_roles text

  Note: 'Referenciado por hotel_rate_calendar.rate_plan_id'
}

Table hotel_images {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  image_url varchar(500) [not null]
  title varchar(255)
  source varchar(50)
  demo_seed bool [default: false]
  created_at timestamp
  updated_at timestamp

  Indexes {
    (prop_id, image_url) [unique]
  }
}

Table hotel_content_pages {
  id varchar(24) [pk]
  prop_id int [unique, not null, ref: > dim_hotels.prop_id]
  description text
  highlights text
  amenities_text text
  active_amenities text
  amenities_catalog text
  room_amenities text
  amenity_prices text
  source varchar(50)
  demo_seed bool
  created_at timestamp
  updated_at timestamp
}

Table hotel_policies {
  id varchar(24) [pk]
  prop_id int [unique, not null, ref: > dim_hotels.prop_id]
  room_type_id varchar(100) [ref: > room_types.room_type_id]
  check_in_time varchar(10)
  check_out_time varchar(10)
  cancellation_policy text
  pet_policy text
  children_policy text
  extra_bed_policy text
  payment_policy text
  house_rules text
  source varchar(50)
  demo_seed bool
  min_stay int
  max_stay int
  cancellation_hours int
  children_allowed bool
  pets_allowed bool
  pet_fee decimal
  extra_bed_fee decimal
  season_id varchar(50)
  created_at timestamp
  updated_at timestamp
}

Table hotel_amenities {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  name varchar(255) [not null]
  icon varchar(100)
  created_at timestamp
  updated_at timestamp

  Note: 'Labels validados contra system_catalogs (catalog_type = amenity)'
}

Table booking_orders {
  id varchar(24) [pk]
  booking_id varchar(100) [unique, not null]
  user_id varchar(24) [ref: > users.id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  status varchar(50) [not null]
  booking_source varchar(50)
  guest_name varchar(255)
  guest_email varchar(255)
  guest_phone varchar(50)
  room_type_id varchar(100) [ref: > room_types.room_type_id]
  check_in_date date
  check_out_date date
  adults int
  children int [default: 0]
  rooms int [default: 1]
  comment text
  special_requests text
  total_price decimal
  currency varchar(10) [default: 'USD']
  total_nights int
  coupon_code varchar(50)
  discount_percent decimal
  original_total_price decimal
  stay_status varchar(50)
  is_test bool [default: false]
  created_by varchar(100)
  created_at timestamp
  updated_at timestamp
}

Table booking_guests {
  id varchar(24) [pk]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  guest_name varchar(255)
  guest_email varchar(255)
  guest_phone varchar(50)
  is_primary bool [default: false]
  is_test bool [default: false]
  created_at timestamp
}

Table booking_status_history {
  id varchar(24) [pk]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  status varchar(50) [not null]
  changed_at timestamp
  reason varchar(100)
  changed_by varchar(100)
  is_test bool [default: false]
}

Table reviews {
  id varchar(24) [pk]
  booking_id varchar(100) [ref: > booking_orders.booking_id]
  prop_id int [ref: > dim_hotels.prop_id]
  user_id varchar(24) [ref: > users.id]
  rating int
  title varchar(255)
  comment text
  moderation_status varchar(50)
  staff_response text
  staff_response_at timestamp
  sentiment_label varchar(50)
  sentiment_score decimal
  sentiment_confidence decimal
  sentiment_analyzed_at timestamp
  service_ratings text
  created_at timestamp
  updated_at timestamp

  Note: 'Tabla operacional. Dual-write a fact_reviews vía _write_both().'
}

Table fact_reviews {
  id varchar(24) [pk]
  operational_review_id varchar(24) [ref: > reviews.id]
  booking_id varchar(100) [ref: > booking_orders.booking_id]
  prop_id int [ref: > dim_hotels.prop_id]
  user_id varchar(24) [ref: > users.id]
  rating int
  title varchar(255)
  comment text
  moderation_status varchar(50)
  staff_response text
  staff_response_at timestamp
  sentiment_label varchar(50)
  sentiment_score decimal
  sentiment_confidence decimal
  sentiment_analyzed_at timestamp
  service_ratings text
  date_key int [ref: > dim_dates.date_key]
  loaded_at timestamp
  execution_id varchar(100)
  created_at timestamp
  updated_at timestamp

  Note: 'Copia analítica (dual-write desde reviews). Agrega dimensiones para queries de dashboard.'
}

Table user_activity_logs {
  id varchar(24) [pk]
  event_key varchar(100) [unique]
  user_id varchar(24) [ref: > users.id]
  username varchar(100)
  email varchar(255)
  action varchar(100) [not null]
  module varchar(50)
  details text
  ip_address varchar(45)
  user_agent text
  created_at timestamp
}

Table search_logs {
  id varchar(24) [pk]
  query varchar(255)
  destination varchar(255)
  country varchar(255)
  min_rating decimal
  page_size int
  searched_at timestamp
}

Table click_events {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  source varchar(50)
  user_id varchar(100)
  clicked_at timestamp
}

// ============================================================================
// TABLAS EXTERNAS REFERENCIADAS
// ============================================================================

Table users {
  id varchar(24) [pk]
  email varchar(255) [unique, not null]
  display_name varchar(255)

  Note: 'Departamento 7: Administración'
}

Table dim_dates {
  date_key int [pk]
  date date

  Note: 'Departamento 8: Analítica'
}

// ============================================================================
// RESUMEN DE RELACIONES
// ============================================================================
// dim_hotels.prop_id         ← room_types, room_inventory_calendar, hotel_rate_calendar,
//                               hotel_images, hotel_content_pages, hotel_policies,
//                               hotel_amenities, booking_orders, reviews, fact_reviews,
//                               click_events, user_activity_logs (prop_id vía contexto)
// room_types.room_type_id    ← room_inventory_calendar, booking_orders
//                                  ↓
// rate_plans.rate_plan_id    ← hotel_rate_calendar
// booking_orders.booking_id  ← booking_guests, booking_status_history, reviews, fact_reviews
// users.id                   ← booking_orders.user_id, reviews.user_id, fact_reviews.user_id,
//                               user_activity_logs.user_id
// reviews.id                 ← fact_reviews.operational_review_id
// dim_dates.date_key         ← fact_reviews.date_key
