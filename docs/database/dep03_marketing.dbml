// ============================================================================
// HOTELDATA HUB - Departamento 3: Marketing Hotelero / Partner
// Modelo de Datos (dbdiagram.io DSL)
// ============================================================================

// ============================================================================
// TABLAS PROPIAS (16 colecciones)
// ============================================================================

Table dim_hotels {
  prop_id int [pk]
  prop_country_id int
  prop_starrating int
  prop_review_score decimal
  prop_brand_bool bool
  prop_location_score1 decimal
  hotel_label varchar(255)
  loaded_at timestamp
  manual_override bool
  name_source varchar(50)
  original_generated_name varchar(255)
  description text
  display_country_label varchar(255)
  display_name varchar(255)
  hotel_name varchar(255)
  updated_at timestamp
  updated_by varchar(100)
  verified_at timestamp
}

Table hotel_profile {
  id varchar(24) [pk]
  prop_id int [unique, not null, ref: > dim_hotels.prop_id]
  display_name varchar(255)
  hotel_name varchar(255)
  address text
  phone varchar(50)
  wifi_ssid varchar(100)
  wifi_password varchar(100)
  check_in_time varchar(10)
  check_out_time varchar(10)
  breakfast_hours varchar(50)
  restaurant_hours varchar(50)
  gym_hours varchar(50)
  pool_hours varchar(50)
  parking_info text
  emergency_contact varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table hotel_profile_changes {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  field varchar(100)
  old_value text
  new_value text
  changed_by varchar(100)
  changed_at timestamp
  reason text
  source varchar(100)
}

Table hotel_content_pages {
  id varchar(24) [pk]
  prop_id int [unique, not null, ref: > dim_hotels.prop_id]
  description text
  highlights text
  amenities_text text
  active_amenities text
  amenities_catalog text
  room_amenities text
  amenity_prices text
  source varchar(50)
  demo_seed bool
  created_at timestamp
  updated_at timestamp
}

Table hotel_images {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  image_url varchar(500) [not null]
  title varchar(255)
  source varchar(50)
  demo_seed bool [default: false]
  created_at timestamp
  updated_at timestamp

  Indexes {
    (prop_id, image_url) [unique]
  }
}

Table hotel_content_changes {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  entity_type varchar(50)
  action varchar(50)
  payload text
  changed_by varchar(100)
  changed_at timestamp
}

Table hotel_policies {
  id varchar(24) [pk]
  prop_id int [unique, not null, ref: > dim_hotels.prop_id]
  room_type_id varchar(100) [ref: > room_types.room_type_id]
  check_in_time varchar(10)
  check_out_time varchar(10)
  cancellation_policy text
  pet_policy text
  children_policy text
  extra_bed_policy text
  payment_policy text
  house_rules text
  source varchar(50)
  demo_seed bool
  min_stay int
  max_stay int
  cancellation_hours int
  children_allowed bool
  pets_allowed bool
  pet_fee decimal
  extra_bed_fee decimal
  season_id varchar(50)
  created_at timestamp
  updated_at timestamp
}

Table system_catalogs {
  id varchar(24) [pk]
  catalog_type varchar(50)
  code varchar(50)
  label varchar(255)
  created_at timestamp
  updated_at timestamp

  Note: 'Catálogo global key-value. Soft-linkeado desde hotel_amenities, hotel_content_pages.amenities_catalog. Sin FK directa.'
}

Table reviews {
  id varchar(24) [pk]
  booking_id varchar(100) [ref: > booking_orders.booking_id]
  prop_id int [ref: > dim_hotels.prop_id]
  user_id varchar(24) [ref: > users.id]
  rating int
  title varchar(255)
  comment text
  moderation_status varchar(50)
  staff_response text
  staff_response_at timestamp
  sentiment_label varchar(50)
  sentiment_score decimal
  sentiment_confidence decimal
  sentiment_analyzed_at timestamp
  service_ratings text
  created_at timestamp
  updated_at timestamp

  Note: 'Tabla operacional. Dual-write a fact_reviews vía _write_both().'
}

Table fact_reviews {
  id varchar(24) [pk]
  operational_review_id varchar(24) [ref: > reviews.id]
  booking_id varchar(100) [ref: > booking_orders.booking_id]
  prop_id int [ref: > dim_hotels.prop_id]
  user_id varchar(24) [ref: > users.id]
  rating int
  title varchar(255)
  comment text
  moderation_status varchar(50)
  staff_response text
  staff_response_at timestamp
  sentiment_label varchar(50)
  sentiment_score decimal
  sentiment_confidence decimal
  sentiment_analyzed_at timestamp
  service_ratings text
  date_key int [ref: > dim_dates.date_key]
  loaded_at timestamp
  execution_id varchar(100)
  created_at timestamp
  updated_at timestamp

  Note: 'Copia analítica (dual-write desde reviews).'
}

Table review_reports {
  id varchar(24) [pk]
  review_id varchar(24) [ref: > reviews.id]
  reported_by varchar(24) [ref: > users.id]
  reason text
  description text
  status varchar(50)
  created_at timestamp

  Note: 'Reportes de reseñas inapropiadas. Creado desde review_reports.py; verifica existencia en reviews.'
}

Table room_features {
  id varchar(24) [pk]
  label varchar(100) [unique, not null]
  category varchar(50)
  icon varchar(100)
  created_by varchar(100)
  created_at timestamp

  Note: 'Catálogo maestro de atributos de habitación. Referenciado como texto en room_types.features (soft-link, no FK).'
}

Table hotel_amenities {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  name varchar(255) [not null]
  icon varchar(100)
  created_at timestamp
  updated_at timestamp

  Note: 'Labels validados contra system_catalogs (catalog_type = amenity)'
}

Table corporate_contracts {
  id varchar(24) [pk]
  contract_id varchar(100) [unique, not null]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  company_name varchar(255) [not null]
  contract_code varchar(50) [not null]
  description text
  discount_percent int [default: 0]
  fixed_rate decimal [default: 0]
  applicable_rate_plan_ids text
  applicable_room_type_ids text
  start_date varchar(10)
  end_date varchar(10)
  is_active bool [default: true]
  created_at timestamp
  updated_at timestamp

  Indexes {
    (prop_id, contract_code) [unique]
  }
}

Table hotels {
  id varchar(24) [pk]
  hotel_code varchar(100) [unique]
  name varchar(255)
  address text
  city varchar(100)
  country varchar(100)
  phone varchar(50)
  email varchar(255)
  website varchar(255)
  stars int
  created_at timestamp
  updated_at timestamp
}

Table user_activity_logs {
  id varchar(24) [pk]
  event_key varchar(100) [unique]
  user_id varchar(24) [ref: > users.id]
  username varchar(100)
  email varchar(255)
  action varchar(100) [not null]
  module varchar(50)
  details text
  ip_address varchar(45)
  user_agent text
  created_at timestamp
}

// ============================================================================
// TABLAS EXTERNAS REFERENCIADAS
// ============================================================================

Table room_types {
  id varchar(24) [pk]
  room_type_id varchar(100) [unique, not null]

  Note: 'Departamento 4: Operaciones'
}

Table booking_orders {
  id varchar(24) [pk]
  booking_id varchar(100) [unique, not null]

  Note: 'Departamento 1: Comercial'
}

Table users {
  id varchar(24) [pk]
  email varchar(255) [unique, not null]
  display_name varchar(255)

  Note: 'Departamento 7: Administración'
}

Table dim_dates {
  date_key int [pk]
  date date

  Note: 'Departamento 8: Analítica'
}

// ============================================================================
// RESUMEN DE RELACIONES
// ============================================================================
// dim_hotels.prop_id         ← hotel_profile, hotel_profile_changes, hotel_content_pages,
//                               hotel_images, hotel_content_changes, hotel_policies,
//                               reviews, fact_reviews, hotel_amenities, corporate_contracts
// room_types.room_type_id    ← hotel_policies.room_type_id
// reviews.id                 ← fact_reviews.operational_review_id, review_reports.review_id
// users.id                   ← reviews.user_id, fact_reviews.user_id,
//                               review_reports.reported_by, user_activity_logs.user_id
// booking_orders.booking_id  ← reviews, fact_reviews
// dim_dates.date_key         ← fact_reviews.date_key
//
// system_catalogs            → soft-link (catalog_type/code) a hotel_amenities, hotel_content_pages
// room_features              → soft-link (label text) a room_types.features
