// ============================================================================
// HOTELDATA HUB - Departamento 9: Servicios al Huésped (In-Stay)
// Modelo de Datos (dbdiagram.io DSL)
// ============================================================================

// ============================================================================
// TABLAS PROPIAS (12 colecciones)
// ============================================================================

Table stay_sessions {
  id varchar(24) [pk]
  token varchar(255) [unique, not null]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_label varchar(100)
  guest_name varchar(255)
  check_in date
  check_out date
  created_at timestamp
  expires_at timestamp
  active bool [default: true]
  deactivated_at timestamp
}

Table stay_messages {
  id varchar(24) [pk]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_label varchar(100)
  sender varchar(20) [not null]
  staff_name varchar(255)
  message text [not null]
  created_at timestamp
  read bool [default: false]
}

Table stay_service_requests {
  id varchar(24) [pk]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_label varchar(100)
  request_type varchar(50) [not null]
  request_type_label varchar(255)
  description text
  status varchar(50) [default: 'pending']
  status_label varchar(255)
  staff_response text
  staff_responded_at timestamp
  created_at timestamp
  resolved_at timestamp
}

Table room_status_log {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  hotel_room_id varchar(100) [ref: > hotel_rooms.hotel_room_id]
  room_type_id varchar(100) [ref: > room_types.room_type_id]
  room_label varchar(100)
  room_number varchar(20)
  status varchar(50) [not null]
  dnd bool [default: false]
  dnd_updated_at timestamp
  note text
  created_at timestamp
  updated_at timestamp

  Indexes {
    (prop_id, hotel_room_id) [unique]
  }
}

Table hotel_profile {
  id varchar(24) [pk]
  prop_id int [unique, not null, ref: > dim_hotels.prop_id]
  display_name varchar(255)
  hotel_name varchar(255)
  address text
  phone varchar(50)
  wifi_ssid varchar(100)
  wifi_password varchar(100)
  check_in_time varchar(10)
  check_out_time varchar(10)
  breakfast_hours varchar(50)
  restaurant_hours varchar(50)
  gym_hours varchar(50)
  pool_hours varchar(50)
  parking_info text
  emergency_contact varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table hotel_policies {
  id varchar(24) [pk]
  prop_id int [unique, not null, ref: > dim_hotels.prop_id]
  room_type_id varchar(100) [ref: > room_types.room_type_id]
  check_in_time varchar(10)
  check_out_time varchar(10)
  cancellation_policy text
  pet_policy text
  children_policy text
  extra_bed_policy text
  payment_policy text
  house_rules text
  source varchar(50)
  demo_seed bool
  min_stay int
  max_stay int
  cancellation_hours int
  children_allowed bool
  pets_allowed bool
  pet_fee decimal
  extra_bed_fee decimal
  season_id varchar(50)
  created_at timestamp
  updated_at timestamp
}

Table hotel_amenities {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  name varchar(255) [not null]
  icon varchar(100)
  created_at timestamp
  updated_at timestamp

  Note: 'Labels validados contra system_catalogs (catalog_type = amenity)'
}

Table additional_charges {
  id varchar(24) [pk]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  concept varchar(255)
  amount decimal
  quantity int [default: 1]
  total decimal
  note text
  created_at timestamp
}

Table guest_folios {
  id varchar(24) [pk]
  folio_number varchar(100) [unique, not null]
  booking_id varchar(100) [unique, not null, ref: > booking_orders.booking_id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  guest_name varchar(255)
  guest_email varchar(255)
  room_label varchar(100)
  hotel_label varchar(255)
  check_in_date date
  check_out_date date
  status varchar(50)
  total_room decimal [default: 0]
  total_charges decimal [default: 0]
  total_discounts decimal [default: 0]
  total_payments decimal [default: 0]
  total_due decimal [default: 0]
  postings text
  posting_count int [default: 0]
  invoice_id varchar(24) [ref: > reservation_invoices.id]
  created_at timestamp
  closed_at timestamp
  closed_by varchar(100)
  updated_at timestamp
}

Table lost_and_found {
  id varchar(24) [pk]
  prop_id int [ref: > dim_hotels.prop_id]
  booking_id varchar(100) [ref: > booking_orders.booking_id]
  status varchar(50)
  description text
  location_found varchar(255)
  reported_by varchar(100)
  created_at timestamp
  updated_at timestamp
}

Table notification_log {
  id varchar(24) [pk]
  notification_type varchar(100) [not null]
  recipient_email varchar(255)
  recipient_name varchar(255)
  booking_id varchar(100) [ref: > booking_orders.booking_id]
  prop_id int [ref: > dim_hotels.prop_id]
  status varchar(50)
  error_message text
  created_at timestamp
}

Table booking_orders {
  id varchar(24) [pk]
  booking_id varchar(100) [unique, not null]
  user_id varchar(24) [ref: > users.id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  status varchar(50) [not null]
  booking_source varchar(50)
  guest_name varchar(255)
  guest_email varchar(255)
  guest_phone varchar(50)
  room_type_id varchar(100) [ref: > room_types.room_type_id]
  check_in_date date
  check_out_date date
  adults int
  children int [default: 0]
  rooms int [default: 1]
  comment text
  special_requests text
  total_price decimal
  currency varchar(10) [default: 'USD']
  total_nights int
  coupon_code varchar(50)
  discount_percent decimal
  original_total_price decimal
  stay_status varchar(50)
  is_test bool [default: false]
  created_by varchar(100)
  created_at timestamp
  updated_at timestamp
}

// ============================================================================
// TABLAS EXTERNAS REFERENCIADAS
// ============================================================================

Table dim_hotels {
  prop_id int [pk]
  hotel_label varchar(255)

  Note: 'Departamento 1: Comercial'
}

Table hotel_rooms {
  id varchar(24) [pk]
  hotel_room_id varchar(100) [unique, not null]

  Note: 'Departamento 4: Operaciones'
}

Table room_types {
  id varchar(24) [pk]
  room_type_id varchar(100) [unique, not null]

  Note: 'Departamento 4: Operaciones'
}

Table reservation_invoices {
  id varchar(24) [pk]
  invoice_number varchar(100) [unique, not null]

  Note: 'Departamento 5: Facturación'
}

Table users {
  id varchar(24) [pk]
  email varchar(255)

  Note: 'Departamento 7: Administración'
}

// ============================================================================
// RESUMEN DE RELACIONES
// ============================================================================
// booking_orders.booking_id   ← stay_sessions, stay_messages, stay_service_requests,
//                                additional_charges, guest_folios, lost_and_found,
//                                notification_log
// dim_hotels.prop_id          ← stay_sessions, stay_messages, stay_service_requests,
//                                room_status_log, hotel_profile, hotel_policies,
//                                hotel_amenities, additional_charges, guest_folios,
//                                lost_and_found, notification_log, booking_orders
// hotel_rooms.hotel_room_id   ← room_status_log
// room_types.room_type_id     ← hotel_policies, room_status_log, booking_orders
// reservation_invoices.id     ← guest_folios.invoice_id
// users.id                    ← booking_orders.user_id
