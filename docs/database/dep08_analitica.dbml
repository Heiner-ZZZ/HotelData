// ============================================================================
// HOTELDATA HUB - Departamento 8: Datos, Analítica y Geolocalización
// Modelo de Datos (dbdiagram.io DSL)
// ============================================================================

// ============================================================================
// TABLAS PROPIAS (22 colecciones)
// ============================================================================

Table fact_hotel_reservations {
  id bigserial [pk]
  source_record_id varchar(100)
  srch_id int [not null]
  date_time timestamp
  date_key int [ref: > dim_dates.date_key]
  site_id int [ref: > dim_sites.site_id]
  visitor_location_country_id int [ref: > dim_visitor_countries.visitor_location_country_id]
  visitor_hist_starrating decimal
  visitor_hist_adr_usd decimal
  prop_country_id int
  prop_id int [ref: > dim_hotels.prop_id]
  prop_starrating int
  prop_review_score decimal
  prop_brand_bool bool
  prop_location_score1 decimal
  price_usd decimal [not null]
  promotion_flag bool [ref: > dim_promotions.promotion_flag]
  srch_destination_id int [ref: > dim_destinations.srch_destination_id]
  srch_length_of_stay int
  srch_booking_window int
  srch_adults_count int
  srch_children_count int
  srch_room_count int
  click_bool bool [ref: > dim_click_status.click_bool]
  reserva_bool bool [ref: > dim_reservation_status.reserva_bool]
  reservas_brutas_usd decimal
  occupancy_profile_id varchar(50) [ref: > dim_occupancy_profile.occupancy_profile_id]
  stay_length_category_id varchar(50) [ref: > dim_stay_length_category.stay_length_category_id]
  booking_window_category_id varchar(50) [ref: > dim_booking_window_category.booking_window_category_id]
  price_category_id varchar(50) [ref: > dim_price_category.price_category_id]
  loaded_at timestamp
  execution_id varchar(100)
  phase varchar(20)
}

Table fact_hotel_events {
  id bigserial [pk]
  source_record_id varchar(100)
  srch_id int [not null]
  date_time timestamp
  date_key int [ref: > dim_dates.date_key]
  site_id int [ref: > dim_sites.site_id]
  visitor_location_country_id int [ref: > dim_visitor_countries.visitor_location_country_id]
  visitor_hist_starrating decimal
  visitor_hist_adr_usd decimal
  prop_country_id int
  prop_id int [ref: > dim_hotels.prop_id]
  prop_starrating int
  prop_review_score decimal
  prop_brand_bool bool
  prop_location_score1 decimal
  price_usd decimal [not null]
  promotion_flag bool [ref: > dim_promotions.promotion_flag]
  srch_destination_id int [ref: > dim_destinations.srch_destination_id]
  srch_length_of_stay int
  srch_booking_window int
  srch_adults_count int
  srch_children_count int
  srch_room_count int
  click_bool bool [ref: > dim_click_status.click_bool]
  reserva_bool bool [ref: > dim_reservation_status.reserva_bool]
  reservas_brutas_usd decimal
  occupancy_profile_id varchar(50) [ref: > dim_occupancy_profile.occupancy_profile_id]
  stay_length_category_id varchar(50) [ref: > dim_stay_length_category.stay_length_category_id]
  booking_window_category_id varchar(50) [ref: > dim_booking_window_category.booking_window_category_id]
  price_category_id varchar(50) [ref: > dim_price_category.price_category_id]
  loaded_at timestamp
  execution_id varchar(100)
  phase varchar(20)
}

Table dim_hotels {
  prop_id int [pk]
  prop_country_id int
  prop_starrating int
  prop_review_score decimal
  prop_brand_bool bool
  prop_location_score1 decimal
  hotel_label varchar(255)
  loaded_at timestamp
  manual_override bool
  name_source varchar(50)
  original_generated_name varchar(255)
  description text
  display_country_label varchar(255)
  display_name varchar(255)
  hotel_name varchar(255)
  updated_at timestamp
  updated_by varchar(100)
  verified_at timestamp
}

Table dim_destinations {
  srch_destination_id int [pk]
  destination_label varchar(255)
  loaded_at timestamp
  destination_display_name varchar(255)
  destination_name varchar(255)
}

Table dim_visitor_countries {
  visitor_location_country_id int [pk]
  visitor_country_label varchar(255)
  loaded_at timestamp
  country_display_name varchar(255)
  country_name varchar(255)
}

Table dim_sites {
  site_id int [pk]
  site_label varchar(255)
  loaded_at timestamp
}

Table dim_dates {
  date_key int [pk]
  date date
  year int
  month int
  day int
  day_of_week int
  loaded_at timestamp
}

Table dim_promotions {
  promotion_flag bool [pk]
  promotion_label varchar(50)
}

Table dim_click_status {
  click_bool bool [pk]
  click_status varchar(50)
}

Table dim_reservation_status {
  reserva_bool bool [pk]
  reservation_status varchar(50)
}

Table dim_occupancy_profile {
  occupancy_profile_id varchar(50) [pk]
  srch_adults_count int
  srch_children_count int
  srch_room_count int
  occupancy_label varchar(255)
  loaded_at timestamp
}

Table dim_stay_length_category {
  stay_length_category_id varchar(50) [pk]
  stay_length_category varchar(100)
  min_nights int
  max_nights int
}

Table dim_booking_window_category {
  booking_window_category_id varchar(50) [pk]
  booking_window_category varchar(100)
  min_days int
  max_days int
}

Table dim_price_category {
  price_category_id varchar(50) [pk]
  price_category varchar(100)
  min_price_usd decimal
  max_price_usd decimal
}

Table etl_executions {
  execution_id varchar(100) [pk]
  phase varchar(20)
  executed_at timestamp
  started_at timestamp
  completed_at timestamp
  duration_seconds decimal
  status varchar(20)
  database varchar(50)
  source text
  records_processed int
  records_rejected int
  loaded_collections text
  final_counts text
}

Table data_quality_reports {
  id varchar(24) [pk]
  execution_id varchar(100) [ref: > etl_executions.execution_id]
  phase varchar(20)
  generated_at timestamp
  source text
  source_rows int
  valid_fact_records int
  invalid_fact_records int
  rejected_records int
  valid_dimension_records int
  invalid_dimension_records int
  completeness_score decimal
  dimensions text
  schema text
  extract text
  parquet text
}

Table rejected_records {
  id varchar(24) [pk]
  source varchar(100)
  reason text
  record_data text
  created_at timestamp
}

Table search_logs {
  id varchar(24) [pk]
  query varchar(255)
  destination varchar(255)
  country varchar(255)
  min_rating decimal
  page_size int
  searched_at timestamp
}

Table kpi_summary {
  id varchar(24) [pk]
  updated_at timestamp
  payload text
}

Table geo_catalog {
  id varchar(24) [pk]
  type varchar(50) [not null]
  code varchar(50) [not null]
  name varchar(255)
  iso_code varchar(10)
  country_code varchar(10)
  state_code varchar(10)
  latitude decimal
  longitude decimal
  is_active bool [default: true]
  created_at timestamp
  updated_at timestamp

  Indexes {
    (type, code) [unique]
  }
}

Table click_events {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  source varchar(50)
  user_id varchar(100)
  clicked_at timestamp
}

Table user_activity_logs {
  id varchar(24) [pk]
  event_key varchar(100) [unique]
  user_id varchar(24) [ref: > users.id]
  username varchar(100)
  email varchar(255)
  action varchar(100) [not null]
  module varchar(50)
  details text
  ip_address varchar(45)
  user_agent text
  created_at timestamp
}

// ============================================================================
// TABLAS EXTERNAS REFERENCIADAS
// ============================================================================

Table users {
  id varchar(24) [pk]
  email varchar(255)

  Note: 'Departamento 7: Administración'
}

// ============================================================================
// RESUMEN DE RELACIONES
// ============================================================================
// fact_hotel_reservations → 12 dimensiones: dim_dates, dim_sites, dim_visitor_countries,
//   dim_hotels, dim_promotions, dim_destinations, dim_click_status,
//   dim_reservation_status, dim_occupancy_profile, dim_stay_length_category,
//   dim_booking_window_category, dim_price_category
// fact_hotel_events        → mismas 12 dimensiones
// dim_hotels.prop_id       ← fact_hotel_reservations, fact_hotel_events, click_events
// etl_executions.execution_id ← data_quality_reports
// users.id                 ← user_activity_logs.user_id
