  prop_id int [not null, ref: > dim_hotels.prop_id]
  guest_name varchar(255)
  guest_email varchar(255)
  room_label varchar(100)
  hotel_label varchar(255)
  check_in_date date
  check_out_date date
  status varchar(50)
  total_room decimal [default: 0]
  total_charges decimal [default: 0]
  total_discounts decimal [default: 0]
  total_payments decimal [default: 0]
  total_due decimal [default: 0]
  postings text
  posting_count int [default: 0]
  invoice_id varchar(24)
  created_at timestamp
  closed_at timestamp
  closed_by varchar(100)
  updated_at timestamp
}

// ============================================================================
// 11. MODULOS ADICIONALES
// ============================================================================

Table geo_catalog {
  id varchar(24) [pk]
  type varchar(50) [not null]
  code varchar(50) [not null]
  name varchar(255)
  iso_code varchar(10)
  country_code varchar(10)
  state_code varchar(10)
  latitude decimal
  longitude decimal
  is_active bool [default: true]
  created_at timestamp
  updated_at timestamp

  Indexes {
    (type, code) [unique]
  }
}

Table reception_shifts {
  id varchar(24) [pk]
  prop_id int [ref: > dim_hotels.prop_id]
  shift_type varchar(50)
  status varchar(50)
  start_time timestamp
  end_time timestamp
  employee_name varchar(255)
  notes text
}

Table lost_and_found {
  id varchar(24) [pk]
  prop_id int [ref: > dim_hotels.prop_id]
  booking_id varchar(100) [ref: > booking_orders.booking_id]
  status varchar(50)
  description text
  location_found varchar(255)
  reported_by varchar(100)
  created_at timestamp
  updated_at timestamp
}

Table click_events {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  source varchar(50)
  user_id varchar(100)
  clicked_at timestamp
}

// ============================================================================
// 12. ETL / CONTROL
// ============================================================================

Table search_logs {
  id varchar(24) [pk]
  query varchar(255)
  destination varchar(255)
  country varchar(255)
  min_rating decimal
  page_size int
  searched_at timestamp
}

Table rejected_records {
  id varchar(24) [pk]
  source varchar(100)
  reason text
  record_data text
  created_at timestamp
}

Table etl_executions {
  execution_id varchar(100) [pk]
  phase varchar(20)
  executed_at timestamp
  started_at timestamp
  completed_at timestamp
  duration_seconds decimal
  status varchar(20)
  database varchar(50)
  source text
  records_processed int
  records_rejected int
  loaded_collections text
  final_counts text
}

Table data_quality_reports {
  id varchar(24) [pk]
  execution_id varchar(100)
  phase varchar(20)
  generated_at timestamp
  source text
  source_rows int
  valid_fact_records int
  invalid_fact_records int
  rejected_records int
  valid_dimension_records int
  invalid_dimension_records int
  completeness_score decimal
  dimensions text
  schema text
  extract text
  parquet text
}

Table audit_log {
  id varchar(24) [pk]
  timestamp timestamp [not null]
  prop_id int [ref: > dim_hotels.prop_id]
  entity_type varchar(50)
  entity_id varchar(100)
  action varchar(50)
  summary text
  changed_by varchar(100)
  metadata text
}

Table kpi_summary {
  id varchar(24) [pk]
  updated_at timestamp
  payload text
}

Table system_catalogs {
  id varchar(24) [pk]
  catalog_type varchar(50)
  code varchar(50)
  label varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table system_config {
  id varchar(24) [pk]
  default_commission_pct decimal
  default_iva_pct decimal
  updated_at timestamp
  updated_by varchar(100)
}

Table amenity_stock {
  id varchar(24) [pk]
  prop_id int
  amenity_label varchar(100)
  room_type_id varchar(100)
  quantity int

  Indexes {
    (prop_id, amenity_label, room_type_id) [unique]
  }
}

Table commission_rates {
  id varchar(24) [pk]
  prop_id int [unique]
  commission_pct decimal
}

Table tax_rates {
  id varchar(24) [pk]
  country_id varchar(10) [unique]
  country_name varchar(100)
  tax_pct decimal
}

// ============================================================================
// 13. EXPENSES Y LIBRO MAYOR
// ============================================================================

Table expense_invoices {
  id varchar(24) [pk]
  vendor_name varchar(255) [not null]
  category varchar(100) [not null]
  description text
  amount decimal [not null]
  tax_amount decimal [default: 0]
  total decimal
  status varchar(50) [default: 'pending']
  invoice_date date
  due_date date
  approved_by varchar(100)
  approved_at timestamp
  notes text
  prop_id int [ref: > dim_hotels.prop_id]
  created_at timestamp
  updated_at timestamp
}

Table expense_categories {
  id varchar(24) [pk]
  name varchar(255) [unique, not null]
  description text
  budget decimal [default: 0]
  spent decimal [default: 0]
  remaining decimal [default: 0]
  created_at timestamp
}

Table expense_budget {
  id varchar(24) [pk]
  department varchar(100) [not null]
  period varchar(20) [not null]
  amount decimal [not null]
  spent decimal [default: 0]
  remaining decimal [default: 0]
  description text
  created_at timestamp
}

Table ledger_transactions {
  id varchar(24) [pk]
  tx_date date [not null]
  folio_ref varchar(100)
  description text
  account_code varchar(50) [not null]
  account_name varchar(255)
  debit decimal [default: 0]
  credit decimal [default: 0]
  balance decimal [default: 0]
  status varchar(50) [default: 'pending']
  prop_id int [ref: > dim_hotels.prop_id]
  user varchar(100)
  notes text
  journal_entry_id varchar(100)
  created_at timestamp
}

Table chart_of_accounts {
  id varchar(24) [pk]
  account_code varchar(50) [unique, not null]
  account_name varchar(255)
  account_type varchar(50)
  is_active bool [default: true]
  created_at timestamp
  updated_at timestamp
}

// ============================================================================
// 14. RECURSOS HUMANOS (HR)
// ============================================================================

Table employees {
  id varchar(24) [pk]
  full_name varchar(255) [not null]
  id_document varchar(100) [unique, not null]
  phone varchar(50)
  email varchar(255)
  address text
  position varchar(100)
  department varchar(100)
  hire_date date
  salary decimal
  emergency_contact varchar(255)
  emergency_phone varchar(50)
  notes text
  prop_id int [ref: > dim_hotels.prop_id]
  is_active bool [default: true]
  created_at timestamp
  updated_at timestamp
}

Table employee_departments {
  id varchar(24) [pk]
  name varchar(255) [unique, not null]
  description text
  head_count int [default: 0]
  created_at timestamp
}

Table employee_documents {
  id varchar(24) [pk]
  employee_id varchar(24) [not null, ref: > employees.id]
  doc_type varchar(50) [not null]
  filename varchar(255)
  notes text
  created_at timestamp
}

Table employee_shifts {
  id varchar(24) [pk]
  employee_id varchar(24) [not null, ref: > employees.id]
  date date [not null]
  scheduled_start varchar(10)
  scheduled_end varchar(10)
  area varchar(100)
  status varchar(50) [default: 'pending']
  actual_check_in timestamp
  actual_check_out timestamp
  notes text
  created_at timestamp
}

// ============================================================================
// 15. IN-STAY (Mi Estancia)
// ============================================================================

Table pending_registrations {
  id varchar(24) [pk]
  username varchar(100)
  email varchar(255) [unique, not null]
  password_hash varchar(255)
  display_name varchar(255)
  code_hash varchar(64)
  attempts int [default: 0]
  created_at timestamp
  expires_at timestamp
}

Table stay_sessions {
  id varchar(24) [pk]
  token varchar(255) [unique, not null]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_label varchar(100)
  guest_name varchar(255)
  check_in date
  check_out date
  created_at timestamp
  expires_at timestamp
  active bool [default: true]
  deactivated_at timestamp
}

Table stay_messages {
  id varchar(24) [pk]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_label varchar(100)
  sender varchar(20) [not null]
  staff_name varchar(255)
  message text [not null]
  created_at timestamp
  read bool [default: false]
}

Table stay_service_requests {
  id varchar(24) [pk]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_label varchar(100)
  request_type varchar(50) [not null]
  request_type_label varchar(255)
  description text
  status varchar(50) [default: 'pending']
  status_label varchar(255)
  staff_response text
  staff_responded_at timestamp
  created_at timestamp
  resolved_at timestamp
}

// ============================================================================
// 16. ANALYTICA ALTERNATIVA
// ============================================================================

Table fact_hotel_events {
  id bigserial [pk]
  source_record_id varchar(100)
  srch_id int [not null]
  date_time timestamp
  date_key int [ref: > dim_dates.date_key]
  site_id int [ref: > dim_sites.site_id]
  visitor_location_country_id int [ref: > dim_visitor_countries.visitor_location_country_id]
  visitor_hist_starrating decimal
  visitor_hist_adr_usd decimal
  prop_country_id int
  prop_id int [ref: > dim_hotels.prop_id]
  prop_starrating int
  prop_review_score decimal
  prop_brand_bool bool
  prop_location_score1 decimal
  price_usd decimal [not null]
  promotion_flag bool [ref: > dim_promotions.promotion_flag]
  srch_destination_id int [ref: > dim_destinations.srch_destination_id]
  srch_length_of_stay int
  srch_booking_window int
  srch_adults_count int
  srch_children_count int
  srch_room_count int
  click_bool bool [ref: > dim_click_status.click_bool]
  reserva_bool bool [ref: > dim_reservation_status.reserva_bool]
  reservas_brutas_usd decimal
  occupancy_profile_id varchar(50) [ref: > dim_occupancy_profile.occupancy_profile_id]
  stay_length_category_id varchar(50) [ref: > dim_stay_length_category.stay_length_category_id]
  booking_window_category_id varchar(50) [ref: > dim_booking_window_category.booking_window_category_id]
  price_category_id varchar(50) [ref: > dim_price_category.price_category_id]
  loaded_at timestamp
  execution_id varchar(100)
  phase varchar(20)
}
