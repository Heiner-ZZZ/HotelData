// ============================================================================
// HOTELDATA HUB - Modelo de Datos (dbdiagram.io DSL)
// Generado desde MongoDB - Julio 2026
// ============================================================================
// Pegar en https://dbdiagram.io para generar el diagrama ER
// ============================================================================

// ============================================================================
// 1. DIMENSIONES (Analytics / Estrella)
// ============================================================================

Table dim_hotels {
  prop_id int [pk]
  prop_country_id int
  prop_starrating int
  prop_review_score decimal
  prop_brand_bool bool
  prop_location_score1 decimal
  hotel_label varchar(255)
  loaded_at timestamp
  manual_override bool
  name_source varchar(50)
  original_generated_name varchar(255)
  description text
  display_country_label varchar(255)
  display_name varchar(255)
  hotel_name varchar(255)
  updated_at timestamp
  updated_by varchar(100)
  verified_at timestamp
}

Table dim_destinations {
  srch_destination_id int [pk]
  destination_label varchar(255)
  loaded_at timestamp
  destination_display_name varchar(255)
  destination_name varchar(255)
}

Table dim_visitor_countries {
  visitor_location_country_id int [pk]
  visitor_country_label varchar(255)
  loaded_at timestamp
  country_display_name varchar(255)
  country_name varchar(255)
}

Table dim_sites {
  site_id int [pk]
  site_label varchar(255)
  loaded_at timestamp
}

Table dim_dates {
  date_key int [pk]
  date date
  year int
  month int
  day int
  day_of_week int
  loaded_at timestamp
}

Table dim_promotions {
  promotion_flag bool [pk]
  promotion_label varchar(50)
}

Table dim_click_status {
  click_bool bool [pk]
  click_status varchar(50)
}

Table dim_reservation_status {
  reserva_bool bool [pk]
  reservation_status varchar(50)
}

Table dim_occupancy_profile {
  occupancy_profile_id varchar(50) [pk]
  srch_adults_count int
  srch_children_count int
  srch_room_count int
  occupancy_label varchar(255)
  loaded_at timestamp
}

Table dim_stay_length_category {
  stay_length_category_id varchar(50) [pk]
  stay_length_category varchar(100)
  min_nights int
  max_nights int
}

Table dim_booking_window_category {
  booking_window_category_id varchar(50) [pk]
  booking_window_category varchar(100)
  min_days int
  max_days int
}

Table dim_price_category {
  price_category_id varchar(50) [pk]
  price_category varchar(100)
  min_price_usd decimal
  max_price_usd decimal
}

// ============================================================================
// 2. TABLA DE HECHOS
// ============================================================================

Table fact_hotel_reservations {
  id bigserial [pk]
  source_record_id varchar(100)
  srch_id int [not null]
  date_time timestamp
  date_key int [ref: > dim_dates.date_key]
  site_id int [ref: > dim_sites.site_id]
  visitor_location_country_id int [ref: > dim_visitor_countries.visitor_location_country_id]
  visitor_hist_starrating decimal
  visitor_hist_adr_usd decimal
  prop_country_id int
  prop_id int [ref: > dim_hotels.prop_id]
  prop_starrating int
  prop_review_score decimal
  prop_brand_bool bool
  prop_location_score1 decimal
  price_usd decimal [not null]
  promotion_flag bool [ref: > dim_promotions.promotion_flag]
  srch_destination_id int [ref: > dim_destinations.srch_destination_id]
  srch_length_of_stay int
  srch_booking_window int
  srch_adults_count int
  srch_children_count int
  srch_room_count int
  click_bool bool [ref: > dim_click_status.click_bool]
  reserva_bool bool [ref: > dim_reservation_status.reserva_bool]
  reservas_brutas_usd decimal
  occupancy_profile_id varchar(50) [ref: > dim_occupancy_profile.occupancy_profile_id]
  stay_length_category_id varchar(50) [ref: > dim_stay_length_category.stay_length_category_id]
  booking_window_category_id varchar(50) [ref: > dim_booking_window_category.booking_window_category_id]
  price_category_id varchar(50) [ref: > dim_price_category.price_category_id]
  loaded_at timestamp
  execution_id varchar(100)
  phase varchar(20)
}

// ============================================================================
// 3. SEGURIDAD
// ============================================================================

Table users {
  id varchar(24) [pk]
  username varchar(100) [unique, not null]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  display_name varchar(255)
  primary_role varchar(50)
  is_active bool [default: true]
  email_verified bool [default: false]
  failed_login_attempts int [default: 0]
  locked_until timestamp
  must_change_password bool [default: false]
  temporary_password bool [default: false]
  role_ids text
  settings text
  created_at timestamp
  updated_at timestamp
  updated_by varchar(100)
  created_by varchar(255)
}

Table roles {
  id varchar(24) [pk]
  role_name varchar(50) [unique, not null]
  display_name varchar(100)
  description text
  is_system bool [default: false]
  created_at timestamp
  updated_at timestamp
}

Table permissions {
  id varchar(24) [pk]
  permission_code varchar(100) [unique, not null]
  description text
  is_system bool [default: false]
  created_at timestamp
  updated_at timestamp
}

Table role_permissions {
  role_id varchar(24) [ref: > roles.id]
  permission_id varchar(24) [ref: > permissions.id]
  role_name varchar(50)
  permission_code varchar(100)
  created_at timestamp
  updated_at timestamp

  Indexes {
    (role_id, permission_id) [pk]
  }
}

Table user_sessions {
  id varchar(24) [pk]
  session_token_hash varchar(64) [unique]
  session_token varchar(255) [unique]
  user_id varchar(24) [ref: > users.id]
  username varchar(100)
  email varchar(255)
  is_active bool [default: true]
  ip_address varchar(45)
  user_agent text
  remember_me bool [default: false]
  end_reason varchar(50)
  created_at timestamp
  expires_at timestamp
  ended_at timestamp
  last_activity_at timestamp
}

Table user_activity_logs {
  id varchar(24) [pk]
  event_key varchar(100) [unique]
  user_id varchar(24)
  username varchar(100)
  email varchar(255)
  action varchar(100) [not null]
  module varchar(50)
  details text
  ip_address varchar(45)
  user_agent text
  created_at timestamp
}

Table refresh_tokens {
  id varchar(24) [pk]
  token_hash varchar(64) [unique]
  user_id varchar(24) [ref: > users.id]
  created_at timestamp
  expires_at timestamp
  used bool [default: false]
}

Table password_recovery_tokens {
  id varchar(24) [pk]
  token_hash varchar(64) [unique]
  user_id varchar(24)
  created_at timestamp
  expires_at timestamp
}

Table email_verification_tokens {
  id varchar(24) [pk]
  token_hash varchar(64) [unique]
  created_at timestamp
  expires_at timestamp
}

Table two_factor_codes {
  id varchar(24) [pk]
  user_id varchar(24)
  code varchar(10)
  created_at timestamp
  expires_at timestamp
}

Table user_2fa {
  id varchar(24) [pk]
  user_id varchar(24) [unique]
  secret varchar(255)
  enabled bool [default: false]
  created_at timestamp
  updated_at timestamp
}

// ============================================================================
// 4. PARTNER / CONTENIDO
// ============================================================================

Table hotel_images {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  image_url varchar(500) [not null]
  title varchar(255)
  source varchar(50)
  demo_seed bool [default: false]
  created_at timestamp
  updated_at timestamp

  Indexes {
    (prop_id, image_url) [unique]
  }
}

Table hotel_policies {
  id varchar(24) [pk]
  prop_id int [unique, not null, ref: > dim_hotels.prop_id]
  room_type_id varchar(100)
  check_in_time varchar(10)
  check_out_time varchar(10)
  cancellation_policy text
  pet_policy text
  children_policy text
  extra_bed_policy text
  payment_policy text
  house_rules text
  source varchar(50)
  demo_seed bool
  min_stay int
  max_stay int
  cancellation_hours int
  children_allowed bool
  pets_allowed bool
  pet_fee decimal
  extra_bed_fee decimal
  season_id varchar(50)
  created_at timestamp
  updated_at timestamp
}

Table hotel_content_pages {
  id varchar(24) [pk]
  prop_id int [unique, not null, ref: > dim_hotels.prop_id]
  description text
  highlights text
  amenities_text text
  active_amenities text
  amenities_catalog text
  room_amenities text
  amenity_prices text
  source varchar(50)
  demo_seed bool
  created_at timestamp
  updated_at timestamp
}

Table hotel_content_changes {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  entity_type varchar(50)
  action varchar(50)
  payload text
  changed_by varchar(100)
  changed_at timestamp
}

Table hotel_profile {
  id varchar(24) [pk]
  prop_id int [unique, not null, ref: > dim_hotels.prop_id]
  display_name varchar(255)
  hotel_name varchar(255)
  address text
  phone varchar(50)
  wifi_ssid varchar(100)
  wifi_password varchar(100)
  check_in_time varchar(10)
  check_out_time varchar(10)
  breakfast_hours varchar(50)
  restaurant_hours varchar(50)
  gym_hours varchar(50)
  pool_hours varchar(50)
  parking_info text
  emergency_contact varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table hotel_amenities {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  name varchar(255) [not null]
  icon varchar(100)
  created_at timestamp
  updated_at timestamp
}

Table hotel_profile_changes {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  field varchar(100)
  old_value text
  new_value text
  changed_by varchar(100)
  changed_at timestamp
  reason text
  source varchar(100)
}

// ============================================================================
// 5. INVENTARIO
// ============================================================================

Table room_types {
  id varchar(24) [pk]
  room_type_id varchar(100) [unique, not null]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  name varchar(255)
  description text
  max_adults int
  max_children int
  base_capacity int
  base_rate decimal
  is_active bool [default: true]
  room_number varchar(20)
  floor varchar(10)
  view varchar(100)
  smoking bool
  accessible bool
  is_roh bool [default: false]
  features text
  created_at timestamp
  updated_at timestamp
}

Table hotel_rooms {
  id varchar(24) [pk]
  hotel_room_id varchar(100) [unique, not null]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_type_id varchar(100) [ref: > room_types.room_type_id]
  room_label varchar(100)
  room_number varchar(20)
  floor varchar(10)
  view varchar(100)
  smoking bool
  accessible bool
  is_active bool [default: true]
  is_roh bool [default: false]
  created_at timestamp
  updated_at timestamp
}

Table room_inventory_calendar {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_type_id varchar(100) [not null, ref: > room_types.room_type_id]
  date date [not null]
  total_rooms int
  available_rooms int
  blocked_rooms int [default: 0]
  version int [default: 1]
  is_deleted bool [default: false]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp

  Indexes {
    (prop_id, room_type_id, date) [unique]
  }
}

Table room_availability_blocks {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_type_id varchar(100) [ref: > room_types.room_type_id]
  start_date date [not null]
  end_date date
  reason varchar(255)
  blocked_rooms int
  room_numbers text
  created_at timestamp
  updated_at timestamp
}

Table blackout_dates {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_type_id varchar(100)
  room_label varchar(100)
  start_date timestamp [not null]
  end_date timestamp
  source varchar(50)
  reason text
  created_at timestamp
}

Table room_features {
  id varchar(24) [pk]
  label varchar(100) [unique, not null]
  category varchar(50)
}

Table hotel_products {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  product_id varchar(100) [not null]
  category varchar(50)

  Indexes {
    (prop_id, product_id) [unique]
  }
}

Table platform_earnings {
  id varchar(24) [pk]
  booking_id varchar(100) [unique, not null]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  commission_pct decimal
  booking_total decimal
  commission_amount decimal
  status varchar(50)
  created_at timestamp
}

// ============================================================================
// 6. RESERVACIONES
// ============================================================================

Table booking_orders {
  id varchar(24) [pk]
  booking_id varchar(100) [unique, not null]
  user_id varchar(24)
  prop_id int [not null, ref: > dim_hotels.prop_id]
  status varchar(50) [not null]
  booking_source varchar(50)
  guest_name varchar(255)
  guest_email varchar(255)
  guest_phone varchar(50)
  room_type_id varchar(100)
  check_in_date date
  check_out_date date
  adults int
  children int [default: 0]
  rooms int [default: 1]
  comment text
  special_requests text
  total_price decimal
  currency varchar(10) [default: 'USD']
  total_nights int
  coupon_code varchar(50)
  discount_percent decimal
  original_total_price decimal
  stay_status varchar(50)
  is_test bool [default: false]
  created_by varchar(100)
  created_at timestamp
  updated_at timestamp
}

Table booking_guests {
  id varchar(24) [pk]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  guest_name varchar(255)
  guest_email varchar(255)
  guest_phone varchar(50)
  is_primary bool [default: false]
  is_test bool [default: false]
  created_at timestamp
}

Table booking_room_guests {
  id varchar(24) [pk]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  room_index int [not null]
  guests text
  created_at timestamp
  updated_at timestamp
  is_test bool [default: false]

  Indexes {
    (booking_id, room_index) [unique]
  }
}

Table booking_status_history {
  id varchar(24) [pk]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  status varchar(50) [not null]
  changed_at timestamp
  reason varchar(100)
  changed_by varchar(100)
  is_test bool [default: false]
}

Table manual_reservations {
  id varchar(24) [pk]
  manual_reservation_id varchar(100) [unique, not null]
  booking_id varchar(100) [ref: > booking_orders.booking_id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  created_at timestamp
}

Table hotel_booking_context {
  id varchar(24) [pk]
  prop_id int [unique, not null, ref: > dim_hotels.prop_id]
  hotel_label varchar(255)
  country int
  review_label varchar(255)
  avg_price_label varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table notification_log {
  id varchar(24) [pk]
  notification_type varchar(100) [not null]
  recipient_email varchar(255)
  recipient_name varchar(255)
  booking_id varchar(100)
  prop_id int
  status varchar(50)
  error_message text
  created_at timestamp
}

// ============================================================================
// 7. REVENUE
// ============================================================================

Table rate_plans {
  id varchar(24) [pk]
  rate_plan_id varchar(100) [unique, not null]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  name varchar(255)
  base_rate decimal
  is_active bool [default: true]
  eligible_roles text
}

Table hotel_rate_calendar {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  rate_plan_id varchar(100) [not null, ref: > rate_plans.rate_plan_id]
  date date [not null]
  rate_amount decimal
  is_closed bool [default: false]

  Indexes {
    (prop_id, rate_plan_id, date) [unique]
  }
}

Table rate_rules {
  id varchar(24) [pk]
  rule_id varchar(100) [unique, not null]
  rate_plan_id varchar(100) [ref: > rate_plans.rate_plan_id]
  prop_id int [ref: > dim_hotels.prop_id]
  name varchar(255)
  price_override decimal
  start_date date
  end_date date
  created_at timestamp
  updated_at timestamp
}

Table promotion_campaigns {
  id varchar(24) [pk]
  campaign_id varchar(100) [unique, not null]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  name varchar(255)
  description text
  discount_percent int
  start_date date
  end_date date
  is_active bool [default: true]
  coupon_count int [default: 0]
  coupons_used int [default: 0]
  created_at timestamp
  updated_at timestamp
}

Table coupon_codes {
  id varchar(24) [pk]
  coupon_code varchar(50) [unique, not null]
  campaign_id varchar(100) [not null, ref: > promotion_campaigns.campaign_id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  discount_percent int
  is_active bool [default: true]
  used bool [default: false]
  used_at timestamp
  created_at timestamp
  updated_at timestamp
}

