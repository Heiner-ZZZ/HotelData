  comment text
  moderation_status varchar(50)
  staff_response text
  staff_response_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table review_reports {
  id varchar(24) [pk]
  review_id varchar(24)
  reported_by varchar(100)
