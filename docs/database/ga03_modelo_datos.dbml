}

Table maintenance_tasks {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_label varchar(100)
  task_type varchar(50)
  title varchar(255)
  description text
  status varchar(50)
  priority varchar(20) [default: 'normal']
  scheduled_date date
  created_at timestamp
  completed_at timestamp
  updated_at timestamp
}

Table additional_charges {
  id varchar(24) [pk]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  concept varchar(255)
  amount decimal
  quantity int [default: 1]
  total decimal
  note text
  created_at timestamp
}

