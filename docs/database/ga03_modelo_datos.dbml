// 9. HOUSEKEEPING
// ============================================================================

Table room_status_log {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  hotel_room_id varchar(100)
  room_type_id varchar(100)
  room_label varchar(100)
  room_number varchar(20)
  status varchar(50) [not null]
  dnd bool [default: false]
  dnd_updated_at timestamp
  note text
  created_at timestamp
  updated_at timestamp

  Indexes {
    (prop_id, hotel_room_id) [unique]
  }
}

Table room_status_history {
  id varchar(24) [pk]
  prop_id int [ref: > dim_hotels.prop_id]
  room_label varchar(100)
  old_status varchar(50)
  new_status varchar(50)
  note text
  changed_by varchar(100)
