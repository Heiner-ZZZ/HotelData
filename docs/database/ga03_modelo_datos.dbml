Table reviews {
  id varchar(24) [pk]
  booking_id varchar(100) [ref: > booking_orders.booking_id]
  prop_id int [ref: > dim_hotels.prop_id]
  user_id varchar(24)
  rating int
  title varchar(255)
  comment text
  moderation_status varchar(50)
  staff_response text
  staff_response_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table fact_reviews {
  id varchar(24) [pk]
  booking_id varchar(100) [ref: > booking_orders.booking_id]
  prop_id int [ref: > dim_hotels.prop_id]
  user_id varchar(24)
  rating int
