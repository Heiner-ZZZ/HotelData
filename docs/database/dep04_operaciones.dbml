// ============================================================================
// HOTELDATA HUB - Departamento 4: Operaciones Hoteleras
// Modelo de Datos (dbdiagram.io DSL)
// ============================================================================

// ============================================================================
// TABLAS PROPIAS (18 colecciones)
// ============================================================================

Table booking_orders {
  id varchar(24) [pk]
  booking_id varchar(100) [unique, not null]
  user_id varchar(24) [ref: > users.id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  status varchar(50) [not null]
  booking_source varchar(50)
  guest_name varchar(255)
  guest_email varchar(255)
  guest_phone varchar(50)
  room_type_id varchar(100) [ref: > room_types.room_type_id]
  check_in_date date
  check_out_date date
  adults int
  children int [default: 0]
  rooms int [default: 1]
  comment text
  special_requests text
  total_price decimal
  currency varchar(10) [default: 'USD']
  total_nights int
  coupon_code varchar(50)
  discount_percent decimal
  original_total_price decimal
  stay_status varchar(50)
  is_test bool [default: false]
  created_by varchar(100)
  created_at timestamp
  updated_at timestamp
}

Table booking_guests {
  id varchar(24) [pk]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  guest_name varchar(255)
  guest_email varchar(255)
  guest_phone varchar(50)
  is_primary bool [default: false]
  is_test bool [default: false]
  created_at timestamp
}

Table booking_room_guests {
  id varchar(24) [pk]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  room_index int [not null]
  guests text
  created_at timestamp
  updated_at timestamp
  is_test bool [default: false]

  Indexes {
    (booking_id, room_index) [unique]
  }
}

Table booking_status_history {
  id varchar(24) [pk]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  status varchar(50) [not null]
  changed_at timestamp
  reason varchar(100)
  changed_by varchar(100)
  is_test bool [default: false]
}

Table manual_reservations {
  id varchar(24) [pk]
  manual_reservation_id varchar(100) [unique, not null]
  booking_id varchar(100) [ref: > booking_orders.booking_id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  created_at timestamp
}

Table room_types {
  id varchar(24) [pk]
  room_type_id varchar(100) [unique, not null]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  name varchar(255)
  description text
  max_adults int
  max_children int
  base_capacity int
  base_rate decimal
  is_active bool [default: true]
  room_number varchar(20)
  floor varchar(10)
  view varchar(100)
  smoking bool
  accessible bool
  is_roh bool [default: false]
  features text
  created_at timestamp
  updated_at timestamp

  Note: 'features almacena array de labels; catálogo en room_features (Dep 3: Marketing)'
}

Table hotel_rooms {
  id varchar(24) [pk]
  hotel_room_id varchar(100) [unique, not null]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_type_id varchar(100) [ref: > room_types.room_type_id]
  room_label varchar(100)
  room_number varchar(20)
  floor varchar(10)
  view varchar(100)
  smoking bool
  accessible bool
  is_active bool [default: true]
  is_roh bool [default: false]
  created_at timestamp
  updated_at timestamp
}

Table room_inventory_calendar {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_type_id varchar(100) [not null, ref: > room_types.room_type_id]
  date date [not null]
  total_rooms int
  available_rooms int
  blocked_rooms int [default: 0]
  version int [default: 1]
  is_deleted bool [default: false]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp

  Indexes {
    (prop_id, room_type_id, date) [unique]
  }
}

Table room_availability_blocks {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_type_id varchar(100) [ref: > room_types.room_type_id]
  start_date date [not null]
  end_date date
  reason varchar(255)
  blocked_rooms int
  room_numbers text
  created_at timestamp
  updated_at timestamp
}

Table blackout_dates {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_type_id varchar(100) [ref: > room_types.room_type_id]
  room_label varchar(100)
  start_date timestamp [not null]
  end_date timestamp
  source varchar(50)
  reason text
  created_at timestamp
}

Table room_status_log {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  hotel_room_id varchar(100) [ref: > hotel_rooms.hotel_room_id]
  room_type_id varchar(100) [ref: > room_types.room_type_id]
  room_label varchar(100)
  room_number varchar(20)
  status varchar(50) [not null]
  dnd bool [default: false]
  dnd_updated_at timestamp
  note text
  created_at timestamp
  updated_at timestamp

  Indexes {
    (prop_id, hotel_room_id) [unique]
  }
}

Table room_status_history {
  id varchar(24) [pk]
  prop_id int [ref: > dim_hotels.prop_id]
  room_label varchar(100)
  old_status varchar(50)
  new_status varchar(50)
  note text
  changed_by varchar(100)
  created_at timestamp
}

Table housekeeping_tasks {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_label varchar(100)
  task_type varchar(50)
  status varchar(50)
  assigned_to varchar(100)
  priority varchar(20) [default: 'normal']
  note text
  scheduled_date timestamp
  created_at timestamp
  completed_at timestamp
  updated_at timestamp
}

Table maintenance_tasks {
  id varchar(24) [pk]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  room_label varchar(100)
  task_type varchar(50)
  title varchar(255)
  description text
  status varchar(50)
  priority varchar(20) [default: 'normal']
  scheduled_date date
  created_at timestamp
  completed_at timestamp
  updated_at timestamp
}

Table reception_shifts {
  id varchar(24) [pk]
  prop_id int [ref: > dim_hotels.prop_id]
  shift_type varchar(50)
  status varchar(50)
  start_time timestamp
  end_time timestamp
  employee_name varchar(255)
  notes text
}

Table additional_charges {
  id varchar(24) [pk]
  booking_id varchar(100) [not null, ref: > booking_orders.booking_id]
  prop_id int [not null, ref: > dim_hotels.prop_id]
  concept varchar(255)
  amount decimal
  quantity int [default: 1]
  total decimal
  note text
  created_at timestamp
}

Table hotel_booking_context {
  id varchar(24) [pk]
  prop_id int [unique, not null, ref: > dim_hotels.prop_id]
  hotel_label varchar(255)
  country int
  review_label varchar(255)
  avg_price_label varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table user_activity_logs {
  id varchar(24) [pk]
  event_key varchar(100) [unique]
  user_id varchar(24) [ref: > users.id]
  username varchar(100)
  email varchar(255)
  action varchar(100) [not null]
  module varchar(50)
  details text
  ip_address varchar(45)
  user_agent text
  created_at timestamp
}

// ============================================================================
// TABLAS EXTERNAS REFERENCIADAS
// ============================================================================

Table dim_hotels {
  prop_id int [pk]
  hotel_label varchar(255)

  Note: 'Departamento 1: Comercial'
}

Table users {
  id varchar(24) [pk]
  email varchar(255)
  display_name varchar(255)

  Note: 'Departamento 7: Administración'
}

// ============================================================================
// RESUMEN DE RELACIONES
// ============================================================================
// dim_hotels.prop_id              ← booking_orders, manual_reservations, room_types,
//                                    hotel_rooms, room_inventory_calendar,
//                                    room_availability_blocks, blackout_dates,
//                                    room_status_log, room_status_history,
//                                    housekeeping_tasks, maintenance_tasks,
//                                    reception_shifts, additional_charges,
//                                    hotel_booking_context
// booking_orders.booking_id       ← booking_guests, booking_room_guests,
//                                    booking_status_history, manual_reservations,
//                                    additional_charges
// room_types.room_type_id         ← booking_orders, hotel_rooms, room_inventory_calendar,
//                                    room_availability_blocks, blackout_dates,
//                                    room_status_log
// hotel_rooms.hotel_room_id       ← room_status_log
// users.id                        ← booking_orders.user_id, user_activity_logs.user_id
