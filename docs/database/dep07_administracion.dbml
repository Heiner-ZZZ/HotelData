// ============================================================================
// HOTELDATA HUB - Departamento 7: Administración del Sistema
// Modelo de Datos (dbdiagram.io DSL)
// ============================================================================

// ============================================================================
// TABLAS PROPIAS (16 colecciones)
// ============================================================================

Table users {
  id varchar(24) [pk]
  username varchar(100) [unique, not null]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  display_name varchar(255)
  primary_role varchar(50)
  is_active bool [default: true]
  email_verified bool [default: false]
  failed_login_attempts int [default: 0]
  locked_until timestamp
  must_change_password bool [default: false]
  temporary_password bool [default: false]
  role_ids text
  settings text
  created_at timestamp
  updated_at timestamp
  updated_by varchar(100)
  created_by varchar(255)
}

Table user_sessions {
  id varchar(24) [pk]
  session_token_hash varchar(64) [unique]
  session_token varchar(255) [unique]
  user_id varchar(24) [ref: > users.id]
  username varchar(100)
  email varchar(255)
  is_active bool [default: true]
  ip_address varchar(45)
  user_agent text
  remember_me bool [default: false]
  end_reason varchar(50)
  created_at timestamp
  expires_at timestamp
  ended_at timestamp
  last_activity_at timestamp
}

Table user_activity_logs {
  id varchar(24) [pk]
  event_key varchar(100) [unique]
  user_id varchar(24) [ref: > users.id]
  username varchar(100)
  email varchar(255)
  action varchar(100) [not null]
  module varchar(50)
  details text
  ip_address varchar(45)
  user_agent text
  created_at timestamp
}

Table roles {
  id varchar(24) [pk]
  role_name varchar(50) [unique, not null]
  display_name varchar(100)
  description text
  is_system bool [default: false]
  created_at timestamp
  updated_at timestamp
}

Table permissions {
  id varchar(24) [pk]
  permission_code varchar(100) [unique, not null]
  description text
  is_system bool [default: false]
  created_at timestamp
  updated_at timestamp
}

Table role_permissions {
  role_id varchar(24) [ref: > roles.id]
  permission_id varchar(24) [ref: > permissions.id]
  role_name varchar(50)
  permission_code varchar(100)
  created_at timestamp
  updated_at timestamp

  Indexes {
    (role_id, permission_id) [pk]
  }
}

Table refresh_tokens {
  id varchar(24) [pk]
  token_hash varchar(64) [unique]
  user_id varchar(24) [ref: > users.id]
  created_at timestamp
  expires_at timestamp
  used bool [default: false]
}

Table password_recovery_tokens {
  id varchar(24) [pk]
  token_hash varchar(64) [unique]
  user_id varchar(24) [ref: > users.id]
  created_at timestamp
  expires_at timestamp
}

Table email_verification_tokens {
  id varchar(24) [pk]
  token_hash varchar(64) [unique]
  user_id varchar(24) [ref: > users.id]
  created_at timestamp
  expires_at timestamp
}

Table two_factor_codes {
  id varchar(24) [pk]
  user_id varchar(24) [ref: > users.id]
  code varchar(10)
  created_at timestamp
  expires_at timestamp
}

Table user_2fa {
  id varchar(24) [pk]
  user_id varchar(24) [unique, ref: > users.id]
  secret varchar(255)
  enabled bool [default: false]
  created_at timestamp
  updated_at timestamp
}

Table pending_registrations {
  id varchar(24) [pk]
  username varchar(100)
  email varchar(255) [unique, not null]
  password_hash varchar(255)
  display_name varchar(255)
  code_hash varchar(64)
  attempts int [default: 0]
  created_at timestamp
  expires_at timestamp
}

Table system_config {
  id varchar(24) [pk]
  default_commission_pct decimal
  default_iva_pct decimal
  updated_at timestamp
  updated_by varchar(100)
}

Table commission_rates {
  id varchar(24) [pk]
  prop_id int [unique, ref: > dim_hotels.prop_id]
  commission_pct decimal
}

Table tax_rates {
  id varchar(24) [pk]
  country_id varchar(10) [unique]
  country_name varchar(100)
  tax_pct decimal
}

Table notification_log {
  id varchar(24) [pk]
  notification_type varchar(100) [not null]
  recipient_email varchar(255)
  recipient_name varchar(255)
  booking_id varchar(100) [ref: > booking_orders.booking_id]
  prop_id int [ref: > dim_hotels.prop_id]
  status varchar(50)
  error_message text
  created_at timestamp
}

// ============================================================================
// TABLAS EXTERNAS REFERENCIADAS
// ============================================================================

Table dim_hotels {
  prop_id int [pk]
  hotel_label varchar(255)

  Note: 'Departamento 1: Comercial'
}

Table booking_orders {
  id varchar(24) [pk]
  booking_id varchar(100) [unique, not null]

  Note: 'Departamento 1: Comercial'
}

// ============================================================================
// RESUMEN DE RELACIONES
// ============================================================================
// users.id                   ← user_sessions, user_activity_logs, refresh_tokens,
//                               password_recovery_tokens, email_verification_tokens,
//                               two_factor_codes, user_2fa
// roles.id                   ← role_permissions
// permissions.id             ← role_permissions
// dim_hotels.prop_id         ← commission_rates, notification_log
// booking_orders.booking_id  ← notification_log
