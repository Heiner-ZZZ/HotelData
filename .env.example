MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=hoteldata_hub
HOTELDATA_PROJECT_ROOT=.
HOTELDATA_RAW_CSV=data/raw/hotels.csv
HOTELDATA_CHUNK_SIZE=50000
HOTELDATA_BATCH_SIZE=5000
HOTELDATA_MIN_DATASET_ROWS=100000
HOTELDATA_FULL_RELOAD=true

POCKETBASE_URL=http://127.0.0.1:8090
# TA02 conserva esta coleccion. Para una ejecucion GA03 aislada tambien puede usarse
# POCKETBASE_COLLECTION=hotel_reservation_events_03 junto con TASK_NUMBER=03.
POCKETBASE_COLLECTION=hotel_reservation_events__2
POCKETBASE_COLLECTION_03=hotel_reservation_events_03
POCKETBASE_PAGE_SIZE=500
POCKETBASE_AUTH_TOKEN=
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

TASK_NUMBER=03
TARGET_RECORDS=300000
GA03_EXPECTED_RECORDS=300000
GA03_SOURCE_CSV=C:/HotelData/data/processed/expedia_reservations_clean.csv
GA03_FULL_RELOAD_FACTS=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=false

# Airflow 3 (obligatorias para el despliegue descompuesto)
# Genera valores únicos para cada entorno; no uses estos ejemplos en producción.
AIRFLOW_DB_PASSWORD=replace-with-a-strong-password
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AIRFLOW_SECRET_KEY=replace-with-a-long-random-api-secret
AIRFLOW_FERNET_KEY=replace-with-a-valid-fernet-key

# Pexels API (imágenes de hoteles y habitaciones)
# Obtén tu key gratis en https://www.pexels.com/api/
PEXELS_API_KEY=

# ClickHouse (analítica OLAP, contenedor Docker)
# ClickHouse no tiene soporte nativo en Windows: se ejecuta como servicio Docker.
# HTTP en 8123, protocolo nativo en 9000.
CLICKHOUSE_DB=hoteldata
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Syncfusion Scheduler (Timeline de reservas)
# La clave es visible en el bundle del frontend; no la consideres un secreto.
# Añádela únicamente en .env/local o en el secreto del entorno de build.
SYNCFUSION_LICENSE_KEY=
