# ==========================================================
# HotelData - Git Ignore
# Backend FastAPI + Mongo/PocketBase + Angular frontend
# ==========================================================

# --------------------------
# Python / Backend
# --------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
ENV/
hoteldata_airflow/venv/
*.egg-info/
dist/
build/

# Python local env/config
.env
.env.*
.env.example
*.local
local_settings.py

# Logs
*.log
logs/
*.out
*.err

# --------------------------
# FastAPI / Uvicorn
# --------------------------
*.pid
gunicorn.pid
uvicorn.pid

# --------------------------
# Airflow local/runtime
# --------------------------
airflow/
airflow_home/
airflow.db
airflow.cfg
standalone_admin_password.txt
webserver_config.py
dags/__pycache__/
*/__pycache__/

# --------------------------
# Data / ETL generated files
# --------------------------
hoteldata_project/data/raw/*
hoteldata_project/data/staging/*
hoteldata_project/data/processed/*
hoteldata_project/data/reports/*
hoteldata_project/data/backups/*
hoteldata_project/data/tmp/*
hoteldata_project/data/temp/*

# keep folder placeholders if you use them
!hoteldata_project/data/raw/.gitkeep
!hoteldata_project/data/staging/.gitkeep
!hoteldata_project/data/processed/.gitkeep
!hoteldata_project/data/reports/.gitkeep
!hoteldata_project/data/backups/.gitkeep

# Heavy data formats
*.csv
*.parquet
*.jsonl
*.sqlite
*.sqlite3
*.db
*.duckdb

# But allow documentation examples if needed
!docs/**/*.csv
!docs/**/*.json
!docs/**/*.md

# --------------------------
# Mongo / backups / dumps
# --------------------------
dump/
mongodb_backup/
mongo_backup/
*.bson
*.metadata.json

# --------------------------
