# --------------------------
pb_data/
hoteldata_project/pb_data/
pb_migrations/
hoteldata_project/pb_migrations/
pb_hooks/
hoteldata_project/pb_hooks/
pb_public/
hoteldata_project/pb_public/
pb_*.db
hoteldata_project/pb_*.db
pocketbase
hoteldata_project/pocketbase
pocketbase.exe
hoteldata_project/pocketbase.exe
pb_data*.db
hoteldata_project/pb_data*.db
pb_data_types_.d.ts
hoteldata_project/pb_data_types_.d.ts

# If you intentionally want to version PB migrations/hooks later,
# remove pb_migrations/ and pb_hooks/ from this ignore.

